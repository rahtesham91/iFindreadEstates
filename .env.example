# Public site URL (used for SEO metadata, sitemap)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# WhatsApp number in international format, digits only (e.g. 971501234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=971509843209

# Inquiry email delivery via Resend (https://resend.com). Without these, enquiries are only logged.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=you@example.com
INQUIRY_FROM_EMAIL=iFind Website <enquiries@your-domain.com>

# Careers applications (CV attachments) use the same RESEND_API_KEY and INQUIRY_FROM_EMAIL.
# Optional: send applications to a different mailbox (comma separated). Falls back to INQUIRY_TO_EMAIL.
CAREERS_TO_EMAIL=hr@your-domain.com
