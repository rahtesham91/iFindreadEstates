# Public site URL (used for SEO metadata, sitemap)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# WhatsApp number in international format, digits only (e.g. 971501234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=971000000000

# Inquiry email delivery via Resend (https://resend.com). Without these, enquiries are only logged.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=you@example.com
INQUIRY_FROM_EMAIL=iFind Website <enquiries@your-domain.com>
